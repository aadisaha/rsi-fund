# Copy to .env.local and fill values locally. Never commit real secrets.

# Operator access for non-localhost API/page access.
AGENT_API_TOKEN=
CRON_SECRET=

# Alpaca read-only account and market data. Keep paper mode for the MVP.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
ALLOW_LIVE_READS=false

# Optional explicit paper capital when Alpaca account reads are unavailable.
PAPER_STARTING_EQUITY_USD=
PAPER_KILL_SWITCH=false

# Durable storage. Leave QUANT_STORAGE_DRIVER empty in production so DATABASE_URL selects Postgres.
DATABASE_URL=
POSTGRES_SSL=false
POSTGRES_POOL_MAX=5
QUANT_STORAGE_DRIVER=

# Kalshi read-only portfolio data. Defaults to demo unless KALSHI_PRODUCTION=true.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PEM=
KALSHI_PRODUCTION=false
# Legacy alias supported for existing local envs. KALSHI_DEMO=false means production.
KALSHI_DEMO=true

# Kalshi minute-candle history/training cache.
KALSHI_HISTORY_DATA_DIR=
KALSHI_HISTORY_MARKETS=
KALSHI_HISTORY_SERIES=
KALSHI_HISTORY_START=
KALSHI_HISTORY_END=
KALSHI_HISTORY_PERIOD_INTERVAL=1
KALSHI_HISTORY_CHUNK_MINUTES=7200
KALSHI_HISTORY_MAX_MARKETS=50000
KALSHI_HISTORY_THROTTLE_MS=250
KALSHI_HISTORY_RETRIES=4
KALSHI_TRSI_MIN_SAMPLES=250
KALSHI_TRSI_HORIZON_MINUTES=15

# Kalshi BTC 15m paper genetic RL. Ingestion agents write JSONL here.
KALSHI_ORDERBOOK_DATA_DIR=
KALSHI_RL_ENABLED=false
KALSHI_RL_SERIES=KXBTC15M
KALSHI_RL_BANKROLL_USD=1000
KALSHI_RL_MAX_MARKET_USD=25
KALSHI_RL_MAX_OPEN_USD=100
KALSHI_RL_POPULATION=64
KALSHI_RL_VALIDATED_PNL_USD=20
KALSHI_RL_WAIT_MS=300000
KALSHI_RL_POLL_MS=5000
KALSHI_RL_INTERVAL_MS=300000

# Kalshi live control plane. Defaults are intentionally blocked.
KALSHI_LIVE_TRADING_ENABLED=false
KALSHI_LIVE_KILL_SWITCH=true
KALSHI_LIVE_MAX_OPEN_USD=500
KALSHI_LIVE_MAX_ORDER_USD=25
KALSHI_LIVE_MAX_FEED_AGE_MS=45000
KALSHI_LIVE_MAX_RECONCILIATION_AGE_MS=60000
KALSHI_LIVE_WORKER_INTERVAL_MS=1000
KALSHI_LIVE_BASE_URL=

# Kalshi BTC 15m pretrained black-box RL, CPU paper shadow.
KALSHI_PRETRAINED_RL_ENABLED=false
KALSHI_PRETRAINED_RL_SERIES=KXBTC15M
KALSHI_PRETRAINED_RL_DATA_DIR=
KALSHI_PRETRAINED_RL_SEQUENCE_MINUTES=32
KALSHI_PRETRAINED_RL_MAX_SAMPLES=4096
KALSHI_PRETRAINED_RL_MAX_CANDLES=120000
KALSHI_PRETRAINED_RL_PRETRAIN_EPOCHS=1
KALSHI_PRETRAINED_RL_RL_EPOCHS=1
KALSHI_PRETRAINED_RL_BATCH_SIZE=64
KALSHI_PRETRAINED_RL_PYTHON=python3
KALSHI_PRETRAINED_RL_INTERVAL_MS=900000

# Paper-cycle controls.
QUANT_DATA_DIR=
CYCLE_SYMBOLS=BTC,ETH,SOL
CYCLE_BASE_URL=http://localhost:3000
CYCLE_INTERVAL_MS=30000

# Optional LLM research agents.
PAPER_RECURSION_ENABLED=true
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Future production infrastructure.
DIGITALOCEAN_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
