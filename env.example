# Copy this file to .env.local, then paste your real keys into .env.local.
# Never commit .env.local or real secrets.

###############################################################################
# Operator access
###############################################################################

# Required for any non-localhost dashboard/API access.
# Generate a long random value, for example: openssl rand -base64 32
AGENT_API_TOKEN=

###############################################################################
# Alpaca paper/read-only broker state and market data
###############################################################################

# Use paper/read-only keys for this MVP. The app does not submit live orders.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# Keep false unless you are intentionally diagnosing live account read access.
# This still does not enable live order placement.
ALLOW_LIVE_READS=false

###############################################################################
# Paper execution guardrails
###############################################################################

# Optional fallback capital if Alpaca account reads are unavailable.
PAPER_STARTING_EQUITY_USD=

# Set true to immediately withhold future paper cycles.
PAPER_KILL_SWITCH=false

###############################################################################
# Durable storage
###############################################################################

# Managed Postgres connection string. When set, Postgres becomes authoritative.
# Example: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Most managed Postgres providers require SSL.
POSTGRES_SSL=true
POSTGRES_POOL_MAX=5

# Leave empty in production. Set to local only for local-file fallback/debugging.
QUANT_STORAGE_DRIVER=

# Optional local data directory override. Usually leave empty.
QUANT_DATA_DIR=

###############################################################################
# Kalshi read-only portfolio data
###############################################################################

KALSHI_API_KEY_ID=

# Paste the private key PEM as a single escaped env var if your host requires it,
# or use your platform's multiline secret support.
KALSHI_PRIVATE_KEY_PEM=

# false means demo by default. Set true only for read-only production portfolio data.
KALSHI_PRODUCTION=false

# Legacy alias supported by the app. KALSHI_DEMO=false means production.
KALSHI_DEMO=true

###############################################################################
# Paper-cycle scheduler and worker
###############################################################################

CYCLE_SYMBOLS=BTC,ETH,SOL
CYCLE_BASE_URL=http://localhost:3000
CYCLE_INTERVAL_MS=30000
CYCLE_IDEMPOTENCY_KEY=
CYCLE_WORKER_POLL_MS=5000
CYCLE_WORKER_ONCE=false

###############################################################################
# Optional LLM research agents
###############################################################################

PAPER_RECURSION_ENABLED=true
LLM_PROVIDER=auto

# OpenAI direct provider.
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenRouter provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

###############################################################################
# Optional deployment/infrastructure integrations
###############################################################################

DIGITALOCEAN_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
