# Copy this file to .env.local, then paste your real keys into .env.local.
# Never commit .env.local or real secrets.

###############################################################################
# Operator access
###############################################################################

# Required for any non-localhost dashboard/API access.
# Generate a long random value, for example: openssl rand -base64 32
AGENT_API_TOKEN=

###############################################################################
# Alpaca paper/read-only broker state and market data
###############################################################################

# Use paper/read-only keys for this MVP. The app does not submit live orders.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# Keep false unless you are intentionally diagnosing live account read access.
# This still does not enable live order placement.
ALLOW_LIVE_READS=false

###############################################################################
# Paper execution guardrails
###############################################################################

# Optional fallback capital if Alpaca account reads are unavailable.
PAPER_STARTING_EQUITY_USD=

# Set true to immediately withhold future paper cycles.
PAPER_KILL_SWITCH=false

###############################################################################
# Durable storage
###############################################################################

# Managed Postgres connection string. When set, Postgres becomes authoritative.
# Example: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Most managed Postgres providers require SSL.
POSTGRES_SSL=true
POSTGRES_POOL_MAX=5

# Leave empty in production. Set to local only for local-file fallback/debugging.
QUANT_STORAGE_DRIVER=

# Optional local data directory override. Usually leave empty.
QUANT_DATA_DIR=

###############################################################################
# Kalshi read-only portfolio data
###############################################################################

KALSHI_API_KEY_ID=

# Paste the private key PEM as a single escaped env var if your host requires it,
# or use your platform's multiline secret support.
KALSHI_PRIVATE_KEY_PEM=

# false means demo by default. Set true only for read-only production portfolio data.
KALSHI_PRODUCTION=false

# Legacy alias supported by the app. KALSHI_DEMO=false means production.
KALSHI_DEMO=true

###############################################################################
# Kalshi historical minute data and empirical t-RSI
###############################################################################

# Defaults to .data/kalshi-history. Use a bigger disk path for long backfills.
KALSHI_HISTORY_DATA_DIR=

# Format: SERIES:TICKER for live candles, historical:TICKER for archived candles.
# Example: KALSHI_HISTORY_MARKETS=SERIES:TICKER,historical:ARCHIVED_TICKER
KALSHI_HISTORY_MARKETS=

# Optional series auto-discovery. Examples: KXBTC15M, KXETH15M.
KALSHI_HISTORY_SERIES=
KALSHI_HISTORY_START=
KALSHI_HISTORY_END=
KALSHI_HISTORY_PERIOD_INTERVAL=1
KALSHI_HISTORY_CHUNK_MINUTES=7200
KALSHI_HISTORY_MAX_MARKETS=50000
KALSHI_HISTORY_THROTTLE_MS=250
KALSHI_HISTORY_RETRIES=4

# Empirical t-RSI activates only after this sample floor is met.
KALSHI_TRSI_MIN_SAMPLES=250
KALSHI_TRSI_HORIZON_MINUTES=15

###############################################################################
# Kalshi BTC 15m paper genetic RL
###############################################################################

# Ingestion agents should append normalized or Kalshi-like JSONL records here.
# Defaults to $QUANT_DATA_DIR/kalshi-orderbook or .data/kalshi-orderbook.
KALSHI_ORDERBOOK_DATA_DIR=

KALSHI_RL_ENABLED=false
KALSHI_RL_SERIES=KXBTC15M
KALSHI_RL_BANKROLL_USD=1000
KALSHI_RL_MAX_MARKET_USD=25
KALSHI_RL_MAX_OPEN_USD=100
KALSHI_RL_POPULATION=64
KALSHI_RL_VALIDATED_PNL_USD=20
KALSHI_RL_WAIT_MS=300000
KALSHI_RL_POLL_MS=5000
KALSHI_RL_INTERVAL_MS=300000

###############################################################################
# Kalshi BTC 15m pretrained black-box RL, CPU paper shadow
###############################################################################

KALSHI_PRETRAINED_RL_ENABLED=false
KALSHI_PRETRAINED_RL_SERIES=KXBTC15M
KALSHI_PRETRAINED_RL_DATA_DIR=
KALSHI_PRETRAINED_RL_SEQUENCE_MINUTES=32
KALSHI_PRETRAINED_RL_MAX_SAMPLES=4096
KALSHI_PRETRAINED_RL_MAX_CANDLES=120000
KALSHI_PRETRAINED_RL_PRETRAIN_EPOCHS=1
KALSHI_PRETRAINED_RL_RL_EPOCHS=1
KALSHI_PRETRAINED_RL_BATCH_SIZE=64
KALSHI_PRETRAINED_RL_PYTHON=python3
KALSHI_PRETRAINED_RL_INTERVAL_MS=900000

###############################################################################
# Paper-cycle scheduler and worker
###############################################################################

CYCLE_SYMBOLS=BTC,ETH,SOL
CYCLE_BASE_URL=http://localhost:3000
CYCLE_INTERVAL_MS=30000
CYCLE_IDEMPOTENCY_KEY=
CYCLE_WORKER_POLL_MS=5000
CYCLE_WORKER_ONCE=false

###############################################################################
# Optional LLM research agents
###############################################################################

PAPER_RECURSION_ENABLED=true
LLM_PROVIDER=auto

# OpenAI direct provider.
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenRouter provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

###############################################################################
# Optional deployment/infrastructure integrations
###############################################################################

DIGITALOCEAN_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
